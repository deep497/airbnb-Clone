# ── Django Core Settings ──────────────────────────────────────────
# Set to False in production
DEBUG=True

# Django secret key (generate a random secure string for production)
SECRET_KEY=django-insecure-airbnb-clone-secret-key-change-in-production-xyz

# Comma-separated hosts allowed to access the backend API (e.g., yourbackend.onrender.com,localhost,127.0.0.1)
ALLOWED_HOSTS=*

# ── CORS Settings ─────────────────────────────────────────────────
# Set to False in production to limit origins
CORS_ALLOW_ALL_ORIGINS=True

# Comma-separated list of allowed origins if CORS_ALLOW_ALL_ORIGINS is False (e.g. https://yourfrontend.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000



